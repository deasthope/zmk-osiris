#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    behaviors {
        soft_off_with_wakeup: soft_off_with_wakeup {
            compatible = "zmk,behavior-soft-off";
            #binding-cells = <0>;
        };
    };

    // 1. Monitor the Q key's ROW pin (Pro Micro pin 3) as the hardware interrupt
    keys {
        compatible = "gpio-keys";
        soft_off_gpio_key: soft_off_gpio_key { 
            gpios = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; 
        };
    };

    // 2. Set the Q key's COL pin (Pro Micro pin 7) high so pressing the key triggers the row input
    wakeup_scan: wakeup_scan {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&soft_off_gpio_key>;
        wakeup-source;
        extra-gpios = <&pro_micro 7 GPIO_ACTIVE_HIGH>;
    };

    // 3. Register your virtual trigger as an official system waker
    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&wakeup_scan>;
    };
    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // Row 1: 11 Physical Keys
                &kp Q     &kp W     &kp E          &kp R     &kp T          &kp Y        &kp U     &kp I     &kp O     &kp P                 &bootloader
                
                // Row 2: 10 Physical Keys + 1 Spacer Matrix Block
                &kp A     &kp S     &kp D          &kp F     &kp G          &kp H        &kp J     &kp K     &kp L     &kp SINGLE_QUOTE      &none
                
                // Row 3: 10 Physical Keys + 1 Spacer Matrix Block
                &kp Z     &kp X     &kp C          &kp V     &kp B          &kp N        &kp M     &kp COMMA &kp DOT   &soft_off_with_wakeup &none
                
                // Row 4: 6 Physical Keys + 5 Spacer Matrix Blocks
                &kp LCTRL &kp LGUI  &kp BACKSPACE  &kp SPACE &bootloader    &sys_reset   &none     &none     &none     &none                 &none
            >;
        };
    };
};
