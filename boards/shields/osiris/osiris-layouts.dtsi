#include <physical_layouts.dtsi>

/ {
    physical_layout_osiris: physical_layout_osiris {
        compatible = "zmk,physical-layout";
        display-name = "Osiris";
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0   100     0>
            , <&key_physical_attrs 100 100  200    0       0   200     0>
            , <&key_physical_attrs 100 100  300    0       0   300     0>
            , <&key_physical_attrs 100 100  400    0       0   400     0>
            , <&key_physical_attrs 100 100  500    0       0   500     0>
            , <&key_physical_attrs 100 100  600    0       0   600     0>
            , <&key_physical_attrs 100 100  700    0       0   700     0>
            , <&key_physical_attrs 100 100  800    0       0   800     0>
            , <&key_physical_attrs 100 100  900    0       0   900     0>
            , <&key_physical_attrs 100 100 1000    0       0  1000     0>
            , <&key_physical_attrs 125 100    0  100       0     0   100>
            , <&key_physical_attrs 100 100  125  100       0   125   100>
            , <&key_physical_attrs 100 100  225  100       0   225   100>
            , <&key_physical_attrs 100 100  325  100       0   325   100>
            , <&key_physical_attrs 100 100  425  100       0   425   100>
            , <&key_physical_attrs 100 100  525  100       0   525   100>
            , <&key_physical_attrs 100 100  625  100       0   625   100>
            , <&key_physical_attrs 100 100  725  100       0   725   100>
            , <&key_physical_attrs 100 100  825  100       0   825   100>
            , <&key_physical_attrs 175 100  925  100       0   925   100>
            , <&key_physical_attrs 175 100    0  200       0     0   200>
            , <&key_physical_attrs 100 100  175  200       0   175   200>
            , <&key_physical_attrs 100 100  275  200       0   275   200>
            , <&key_physical_attrs 100 100  375  200       0   375   200>
            , <&key_physical_attrs 100 100  475  200       0   475   200>
            , <&key_physical_attrs 100 100  575  200       0   575   200>
            , <&key_physical_attrs 100 100  675  200       0   675   200>
            , <&key_physical_attrs 100 100  775  200       0   775   200>
            , <&key_physical_attrs 100 100  875  200       0   875   200>
            , <&key_physical_attrs 125 100  975  200       0   975   200>
            , <&key_physical_attrs 100 100  150  300       0   150   300>
            , <&key_physical_attrs 125 100  250  300       0   250   300>
            , <&key_physical_attrs 175 100  375  300       0   375   300>
            , <&key_physical_attrs 175 100  550  300       0   550   300>
            , <&key_physical_attrs 125 100  725  300       0   725   300>
            , <&key_physical_attrs 100 100  850  300       0   850   300>
            ;
    };
};
